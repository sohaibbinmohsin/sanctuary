VITE_SUPABASE_URL=
# Prefer publishable key from Supabase API settings (new naming).
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias (optional if publishable key is set):
# VITE_SUPABASE_ANON_KEY=
VITE_POWERSYNC_URL=
VITE_R2_PUBLIC_BASE_URL=
